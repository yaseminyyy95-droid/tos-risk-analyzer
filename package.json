{
  "name": "tos-risk-analyzer",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.content.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "fixtures:build": "tsx scripts/build-fixtures.ts",
    "harness:build": "vite build --config vite.harness.config.ts",
    "harness:serve": "vite preview --config vite.harness.config.ts --port 4173 --strictPort",
    "e2e": "npm run harness:build && node tests/e2e/run-e2e.mjs",
    "e2e:video:check": "node scripts/check-video.mjs",
    "smoke": "npm run build && node tests/smoke/extension.smoke.mjs",
    "eval:fetch": "tsx eval/scripts/fetch.ts",
    "eval:run": "tsx eval/scripts/run.ts",
    "eval:score": "tsx eval/scripts/score.ts",
    "eval:adversarial": "tsx eval/scripts/adversarial.ts",
    "eval:validate-gold": "tsx eval/scripts/validate-gold.ts",
    "eval:all": "tsx eval/scripts/all.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@eslint/js": "^9.39.5",
    "@preact/preset-vite": "^2.10.6",
    "@types/chrome": "^0.0.300",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "preact": "^10.29.8",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
